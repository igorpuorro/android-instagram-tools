# Copy to .env and edit. Read by compose.yaml (docker compose / podman compose).

# The phone's address under Developer options -> Wireless debugging ("IP address & Port").
# The port changes when wireless debugging is switched on again or the phone restarts.
PHONE=192.168.1.23:41235

# Your time zone, so log times match your PC's clock (the container default is UTC).
TZ=Europe/Berlin
